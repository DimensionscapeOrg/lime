<?xml version="1.0" encoding="utf-8"?>
<project>

	<!-- Opens SceneCheck with a URL while it isn't running: a cold start with a URL, which an app opening another app's URL asks no one about -->
	<meta title="SceneHelper" package="org.openfl.lime.scenehelper" version="1.0.0" company="OpenFL" />
	<app main="Main" path="Export" file="SceneHelper" />
	<window width="0" height="0" fps="60" background="#00FFFF" />

	<source path="Source" />
	<assets path="Assets" />
	<haxelib name="lime" />

</project>
