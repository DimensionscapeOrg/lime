<?xml version="1.0" encoding="utf-8"?>
<project>

	<meta title="SceneCheck" package="org.openfl.lime.scenecheck" version="1.0.0" company="OpenFL" />
	<app main="Main" path="Export" file="SceneCheck" />

	<!-- Landscape only, so coming back from the background laid out for portrait (#2111) shows in the size -->
	<window width="0" height="0" fps="60" background="#FF00FF" orientation="landscape" />

	<source path="Source" />
	<!-- One asset, as a project without any fails to build with Xcode 27 on its own account -->
	<assets path="Assets" />
	<haxelib name="lime" />

</project>
